# The backend's settings. Copy to .env (gitignored) and uncomment what you change; a commented
# line keeps the code's default, shown after the "=". Load it with
# `.venv/bin/uvicorn main:app --env-file .env`. A variable already set in the shell wins over
# this file. Leave a line commented rather than empty: an empty value replaces the default.

# Claude API key, read by the Anthropic SDK (AGENT_RUNTIME=api). Unset: an `ant auth login` profile.
# ANTHROPIC_API_KEY=

# Who answers: "api" (the Claude API) or "claude-code" (your local Claude Code login, dev only).
# AGENT_RUNTIME=api

# Origins whose pages may open md2ui's socket, comma-separated: the web dev server, the app's embed page.
# ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8787

# The conversation's model with AGENT_RUNTIME=api.
# CLAUDE_MODEL=claude-opus-5-5

# The conversation's model with AGENT_RUNTIME=claude-code.
# CLAUDE_CODE_MODEL=claude-opus-5-5

# The conversation's effort per turn with AGENT_RUNTIME=api.
# CLAUDE_EFFORT=medium

# The home writer's model, in both runtimes. Unset: CLAUDE_MODEL.
# HOME_MODEL=claude-opus-5-5

# The home writer's effort, in both runtimes.
# HOME_EFFORT=low

# 1 starts with an order on its way, so home shows its tracking card. Unset: off.
# DEMO_SEED_ORDER=1

# Seconds each order step takes; an order can be cancelled during its first two steps.
# ORDER_STAGE_SECONDS=120
